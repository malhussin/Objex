# Objex needs none of this: start the container and configure it in the browser.
# Everything below is optional. Any value you set here overrides what is entered
# in the UI, and that field becomes read-only ("managed by environment").

# Require a token before the connection can be changed from the UI.
# Recommended whenever Objex is reachable by anyone but you.
# OBJEX_ADMIN_TOKEN=change-me

# Pin the bucket / project instead of choosing them in the setup screen.
# GCP_BUCKET_NAME=my-bucket-name
# GCP_PROJECT_ID=my-gcp-project

# Use a mounted key file instead of pasting the key into the UI.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-credentials.json

# Where the connection saved from the UI is stored. The Docker image sets this
# to /app/data/objex-config.json; locally it defaults to ./.objex/config.json.
# OBJEX_CONFIG_PATH=./.objex/config.json
